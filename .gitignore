# Vendored ML binaries — reproducible, not source.
# ~116MB of ONNX weights + ORT runtime. Kept out of git history because this
# is a public repo and these get swapped as the detector changes.
# Re-fetch per spike/README.md; rebuild the bundle with:
#   cd spike && npm install && npm run build-chrome-harness
spike/chrome-harness/models/
spike/chrome-harness/ort/
spike/chrome-harness/offscreen.bundle.js
extension/models/*
# v2: the UltraFace model is TRACKED -- it is a derived file (upstream Linzaer RFB-320 optimised by
# sih-2026's scripts/optimize-vision-model.py), not downloadable byte-identically. ~1.2 MB, MIT.
!extension/models/ultraface/
extension/ort/*
extension/offscreen.bundle.js
spike-ui-detector/models/
spike-ui-detector/chrome-harness/models/
spike-ui-detector/chrome-harness/ort/
spike-ui-detector/chrome-harness/offscreen.bundle.js

# Python venv
.venv/

# server/main.py debug dump (DEBUG_DUMP_DIR) -- OFF by default, opt-in
# for inspecting redaction placement. Matches any directory literally
# named debug_dumps anywhere in the tree (e.g. server/debug_dumps/),
# which is the name used in server/README.md's example. May contain
# UNREDACTED PII -- see the safety note there. If you point
# DEBUG_DUMP_DIR at a different name/location, .gitignore that path too.
debug_dumps/

# v2 spikes: model weights, HF caches, venvs and run logs are reproducible, never committed
spikes/gliner/.hf/
spikes/gliner/.venv/
spikes/gliner/models/
spikes/gliner/*.log
spikes/ultraface/models/
spikes/**/node_modules/
benchmarks/**/node_modules/
# start/stop-demo PID tracking (local runtime state)
demo-pids.json
